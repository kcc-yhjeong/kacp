# kacp/app-runtime-node — work and public copies of Node apps. uid 1000 (node).
FROM node:22-bookworm-slim
COPY entrypoint.sh /usr/local/bin/kacp-entrypoint
RUN chmod 755 /usr/local/bin/kacp-entrypoint && mkdir -p /app /app-data && chown node:node /app /app-data
USER node
WORKDIR /app
ENTRYPOINT ["/usr/local/bin/kacp-entrypoint"]
