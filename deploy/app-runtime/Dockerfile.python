# kacp/app-runtime-python — work and public copies of Python apps. uid 1000.
FROM python:3.12-slim-bookworm
COPY entrypoint.sh /usr/local/bin/kacp-entrypoint
RUN chmod 755 /usr/local/bin/kacp-entrypoint && useradd --uid 1000 --create-home app \
    && mkdir -p /app /app-data && chown app:app /app /app-data
ENV PIP_ROOT_USER_ACTION=ignore PYTHONUNBUFFERED=1
USER app
WORKDIR /app
ENTRYPOINT ["/usr/local/bin/kacp-entrypoint"]
