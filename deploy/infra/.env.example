# Local defaults. Copy to .env and fill the secrets (never commit .env).
BASE_DOMAIN=kacp.localhost
PUBLIC_SCHEME=http
HTTP_PORT=80
TRAEFIK_IP=172.30.0.10
OPENCLAW_IMAGE=kacp/openclaw:2026.9.7-1

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32
INTERNAL_TOKEN=
# openssl rand -base64 32   (exactly 32 bytes)
APP_ENCRYPTION_KEY=

# Model provider key passed into team containers until platform settings arrive (stage 3).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
